# Google Workspace OAuth (desktop app credentials)
# Create an "OAuth client ID" of type "Desktop app" at
# https://console.cloud.google.com/apis/credentials — enable the Gmail and
# Drive APIs — then copy the values here and rename this file to .env
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Ceiling on distinct rows taken from a CSV/TSV ingest (default 2000).
# Every row past this costs an LLM extraction call, so a large export is
# read only up to this budget — the Ingestion tab reports when that happens.
# Raise it if you want more coverage and can wait for it.
#INGEST_MAX_CSV_ROWS=2000
